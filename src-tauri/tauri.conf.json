{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daliscope",
  "version": "0.1.1",
  "identifier": "dev.madhav.daliscope",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Daliscope",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "DALI bus monitor and commissioning tool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-daliscope.rules": "../packaging/99-daliscope.rules"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}